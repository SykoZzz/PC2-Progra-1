@model PortalInmobiliario.Models.ViewModels.CatalogoViewModel
@{
    ViewData["Title"] = "Catálogo";
}
<h2>Catálogo</h2>

<form method="get" asp-action="Index">
    <div>
        <label>Ciudad</label>
        <input asp-for="Ciudad" name="ciudad" value="@Model.Ciudad" />
        <span asp-validation-for="Ciudad"></span>
    </div>
    <div>
        <label>Tipo</label>
    <select name="tipo">
        <option value="">-- Todos --</option>
        @foreach (var t in Enum.GetValues(typeof(TipoInmueble)))
        {
            <option value="@((int)t)" selected="@(Model.Tipo == (TipoInmueble?)t)">
                @t
            </option>
        }
    </select>
    </div>
    <div>
        <label>Precio Min</label>
        <input type="number" step="0.01" name="precioMin" value="@Model.PrecioMin" />
        <label>Precio Max</label>
        <input type="number" step="0.01" name="precioMax" value="@Model.PrecioMax" />
    </div>
    <div>
        <label>Dormitorios >=</label>
        <input type="number" name="dormitorios" value="@Model.Dormitorios" />
    </div>
    <div>
        <button type="submit">Filtrar</button>
    </div>
    <div asp-validation-summary="All"></div>
</form>

<hr/>

<ul>
@foreach(var i in Model.Inmuebles)
{
    <li>
        <a asp-action="Detalle" asp-route-id="@i.Id">@i.Titulo</a> - @i.Ciudad - @i.Precio
    </li>
}
</ul>

<div>
    @if(Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)">Anterior</a> }
    @if(Model.Page * Model.PageSize < Model.Total) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)">Siguiente</a> }
</div>
